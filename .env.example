# FlowPilot environment configuration

# Server
PORT=4000
NODE_ENV=development
HOST=0.0.0.0

# Database: SQLite via Node's built-in node:sqlite module — zero native
# dependencies, no download required. The file lives at STORAGE_DIR/flowpilot.db
# and is created automatically on first run. (prisma/schema.prisma documents
# this same data model for a future PostgreSQL swap.)

# Auth
JWT_SECRET=change-this-to-a-long-random-string-in-production
SESSION_COOKIE_NAME=flowpilot_session

# Credential encryption (32-byte key, base64). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# Browser engine
BROWSER_HEADLESS=false
BROWSER_DEFAULT_TIMEOUT_MS=30000
# Paths below are relative to apps/server (where the compiled server runs
# from); ../../ lands at the repo root, alongside prisma/ and apps/.
BROWSER_PROFILES_DIR=../../storage/browser-profiles

# File storage
STORAGE_DIR=../../storage
SCREENSHOTS_DIR=../../screenshots
DOWNLOADS_DIR=../../storage/downloads
UPLOADS_DIR=../../storage/uploads

# Web app
VITE_API_URL=http://localhost:4000

# Optional: Redis for BullMQ (leave blank to use in-process scheduler fallback)
REDIS_URL=
